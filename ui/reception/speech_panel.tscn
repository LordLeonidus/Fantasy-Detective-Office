[gd_scene format=3]

[ext_resource type="Script" path="res://ui/reception/speech_panel.gd" id="1_speech"]

[node name="SpeechPanel" type="PanelContainer"]
offset_right = 920.0
offset_bottom = 250.0
script = ExtResource("1_speech")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SpeakerLabel" type="Label" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20

[node name="RetellButton" type="Button" parent="Margin/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Расскажите с начала"

[node name="SpeechText" type="RichTextLabel" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 24
bbcode_enabled = true
meta_underlined = false
