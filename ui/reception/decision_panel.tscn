[gd_scene format=3]

[ext_resource type="Script" path="res://ui/reception/decision_panel.gd" id="1_decision"]

[node name="DecisionPanel" type="PanelContainer"]
offset_right = 400.0
offset_bottom = 180.0
script = ExtResource("1_decision")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="QueueLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="DecisionRow" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DecisionOption" type="OptionButton" parent="Margin/Column/DecisionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="ApplyButton" type="Button" parent="Margin/Column/DecisionRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Оформить"

[node name="CallNextButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Позвать следующего"
