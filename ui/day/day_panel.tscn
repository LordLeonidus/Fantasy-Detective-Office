[gd_scene format=3]

[ext_resource type="Script" path="res://ui/day/day_panel.gd" id="1_day"]

[node name="DayPanel" type="PanelContainer"]
offset_right = 300.0
offset_bottom = 150.0
script = ExtResource("1_day")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DayLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "День 1"

[node name="MoneyLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="PendingLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16

[node name="EndDayButton" type="Button" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Закончить день"
