monologue = "Сынок, [у меня кошель украли|koshel]. [Плыла на пароме|parom] [от Рыночной пристани|pristan], [вчера утром|vchera_utrom]. [Народу — не протолкнуться|tesno]. [Дома смотрю: корзинка перевёрнута, кошеля нет|korzinka]. А [там вся выручка за травы|vyruchka]."
knowledge = Array[ExtResource("3_entry")]([SubResource("e_irena_01"), SubResource("e_irena_02"), SubResource("e_irena_03"), SubResource("e_irena_04"), SubResource("e_irena_05"), SubResource("e_irena_06"), SubResource("e_irena_07"), SubResource("e_irena_08"), SubResource("e_irena_09"), SubResource("e_irena_10"), SubResource("e_irena_11"), SubResource("e_irena_12"), SubResource("e_irena_13"), SubResource("e_irena_14"), SubResource("e_irena_15"), SubResource("e_irena_16"), SubResource("e_irena_17"), SubResource("e_irena_18")])
fallback_replies = PackedStringArray("Ой, не помню я, сынок.", "Да откуда ж мне знать...", "Не знаю я, не обратила внимания.")
